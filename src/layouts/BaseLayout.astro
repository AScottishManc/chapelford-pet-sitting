---
import { getEntry } from 'astro:content';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import Hero, { type HeroProps } from '../components/Hero/Hero.astro';
import type { Crumb } from '../components/Breadcrumb/Breadcrumb.astro';
import { navItems } from '../components/Navigation/items';
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource-variable/open-sans';
import '@fontsource-variable/open-sans/standard-italic.css';
import '../styles/main.scss';

interface Props {
  title: string;
  description: string;
  heading?: string;
  hero?: HeroProps;
}

const { title, description, heading, hero } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const pageTitle = title === 'Home' ? site.businessName : `${title} | ${site.businessName}`;

// Breadcrumb from the menu: Home / section / page
const path = Astro.url.pathname;
const section = navItems.find((item) => item.children?.some((child) => child.href === path));
const navItem = section?.children?.find((child) => child.href === path) ?? navItems.find((item) => item.href === path);
const breadcrumb: Crumb[] = [
  { label: 'Home', href: '/' },
  ...(section ? [{ label: section.label, href: section.href }] : []),
  { label: navItem?.label ?? heading ?? title },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <div class="container page page--full">
      <a class="skip-link" href="#site-nav">Skip to Navigation</a>
      <a class="skip-link" href="#content">Skip to Content</a>

      <div class="page__header">
        <Header />
      </div>

      {hero ? (
        <Hero {...hero} />
      ) : heading && (
        <Hero heading={heading} size="small" breadcrumb={breadcrumb} />
      )}

      <main id="content" class="page__main">
        <slot />
      </main>
    </div>

    <Footer />
  </body>
</html>
