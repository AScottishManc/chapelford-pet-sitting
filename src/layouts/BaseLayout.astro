---
import { getEntry } from 'astro:content';
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import menuIcon from '../assets/images/ui/menu-icon-large.png';
import closeIcon from '../assets/images/ui/close-icon-large.png';
// Self-hosted so visitors' browsers never contact Google
import '@fontsource/lato/300.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@fontsource-variable/open-sans';
import '@fontsource-variable/open-sans/standard-italic.css';
import '../styles/main.scss';

interface Props {
  title: string;
  description: string;
  /** Box ids from src/content/sidebar.yaml */
  sidebar?: string[];
}

const { title, description, sidebar = ['recent-news'] } = Astro.props;
const site = (await getEntry('settings', 'site'))!.data;
const pageTitle = title === 'Home' ? site.businessName : `${title} | ${site.businessName}`;
// Encoded because the dev path contains the folder name, which has spaces
const imageVars = [
  `--menu-icon: url("${encodeURI(menuIcon.src)}")`,
  `--close-icon: url("${encodeURI(closeIcon.src)}")`,
].join('; ');
---

<!doctype html>
<html lang="en-GB" style={imageVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <div id="container">
      <a class="skip-link" href="#nav-wrap">Skip to Navigation</a>
      <a class="skip-link" href="#content">Skip to Content</a>

      <Header />
      <Navigation />

      <main id="content">
        <slot />
      </main>

      <Sidebar boxes={sidebar} />
      <Footer />
    </div>
  </body>
</html>
