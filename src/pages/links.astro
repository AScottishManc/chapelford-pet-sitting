---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard/LinkCard.astro';
import RichText from '../components/RichText/RichText.astro';

const entry = (await getEntry('pages', 'links'))!;
const { Content } = await render(entry);
const page = entry.data;
const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  <RichText>
    <Content />
  </RichText>

  <div class="links-page__list">
    {links.map(({ data }) => <LinkCard {...data} />)}
  </div>
</BaseLayout>
