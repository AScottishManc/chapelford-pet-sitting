---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = (await getEntry('pages', 'extras'))!;
const { Content } = await render(entry);
const page = entry.data;
---

<BaseLayout title={page.title} description={page.description} sidebar={page.sidebar}>
  <h1>{page.heading ?? page.title}</h1>
  {page.image && <Image class="img_right" src={page.image} alt={page.imageAlt ?? ''} />}
  <Content />
</BaseLayout>
