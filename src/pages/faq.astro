---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { blockMarkdown, inlineMarkdown } from '../lib/markdown';

const page = (await getEntry('pages', 'faq'))!.data;
const questions = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={page.title} description={page.description} sidebar={page.sidebar} heading={page.heading ?? page.title}>

  <ol class="top">
    {questions.map(({ id, data }) => (
      <li><a href={`#${id}`} title="Direct to answer">{data.question}</a></li>
    ))}
  </ol>

  {questions.map(({ id, data }, index) => (
    <>
      <p id={id} class="bold">{index + 1}. {data.question}</p>
      <Fragment set:html={blockMarkdown(data.answer)} />
      <a class="top_link" href="#top"><p>Back to the top</p></a>
    </>
  ))}

  {page.outro.map((paragraph) => <p set:html={inlineMarkdown(paragraph)} />)}
</BaseLayout>
