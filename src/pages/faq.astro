---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Accordion from '../components/Accordion/Accordion.astro';
import Intro from '../components/Intro/Intro.astro';
import { blockMarkdown, inlineMarkdown } from '../lib/markdown';

const page = (await getEntry('pages', 'faq'))!.data;
const questions = (await getCollection('faq'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(({ id, data }) => ({ id, question: data.question, answer: blockMarkdown(data.answer) }));
---

<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  {page.intro && <Intro text={page.intro} />}

  <Accordion items={questions} name="faq" />

  {page.outro.map((paragraph) => <p set:html={inlineMarkdown(paragraph)} />)}
</BaseLayout>
