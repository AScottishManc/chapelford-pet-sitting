---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = (await getEntry('pages', 'news'))!.data;
const posts = await Promise.all(
  (await getCollection('news'))
    .sort((a, b) => b.data.number - a.data.number)
    .map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })),
);

/** e.g. "12th January 2018", as on the old site */
function formatDate(date: Date): string {
  const day = date.getUTCDate();
  const suffix =
    day % 100 >= 11 && day % 100 <= 13 ? 'th' : ({ 1: 'st', 2: 'nd', 3: 'rd' } as Record<number, string>)[day % 10] ?? 'th';
  const monthYear = date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  return `${day}${suffix} ${monthYear}`;
}
---

<BaseLayout title={page.title} description={page.description} sidebar={page.sidebar} heading={page.heading ?? page.title}>

  {posts.map((post) => (
    <>
      <article class="news" id={`blog_${post.number}`}>
        <header>
          <h1>{post.title}</h1>
          <p>
            Published: <time datetime={post.date.toISOString().slice(0, 10)}>{formatDate(post.date)}</time>
          </p>
        </header>
        {post.image && (
          <Image
            class={`img_${post.imagePosition}`}
            src={post.image}
            alt={post.imageAlt ?? ''}
            width={post.imageWidth}
            height={post.imageHeight}
          />
        )}
        <post.Content />
        <a class="top_link" href="#top"><p>Back to the top</p></a>
      </article>
      <br />
    </>
  ))}
</BaseLayout>
