---
// Numbers and email come from settings.yaml
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon/Icon.astro';
import ContactForm from '../components/ContactForm/ContactForm.astro';
import Intro from '../components/Intro/Intro.astro';
import RichText from '../components/RichText/RichText.astro';

const entry = (await getEntry('pages', 'contact'))!;
const { Content } = await render(entry);
const page = entry.data;
const site = (await getEntry('settings', 'site'))!.data;

const telLink = (number: string) => `tel:${number.replace(/\D/g, '').replace(/^0/, '+44')}`;

// Percent-encode every character of the address, as the old site did, so
// simple spam bots can't read it from the page source.
const encodedEmail = [...site.email]
  .map((char) => '%' + char.charCodeAt(0).toString(16).toUpperCase().padStart(2, '0'))
  .join('');
---

<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  {page.intro && <Intro text={page.intro} />}

  <RichText>
    <Content />
  </RichText>

  <div class="contact-page__cards">
    <section class="contact-page__card">
      <span class="contact-page__icon"><Icon name="phone" /></span>
      <h2 class="contact-page__title">Telephone</h2>
      <p class="contact-page__detail">
        <span class="contact-page__label">Mobile</span>
        <a href={telLink(site.phone)}>{site.phone}</a>
      </p>
      {site.landline && (
        <p class="contact-page__detail">
          <span class="contact-page__label">Landline</span>
          <a href={telLink(site.landline)}>{site.landline}</a>
        </p>
      )}
    </section>

    <section class="contact-page__card">
      <span class="contact-page__icon"><Icon name="email" /></span>
      <h2 class="contact-page__title">Email</h2>
      <p class="contact-page__detail">Send me your questions or the dates you need, and I'll reply as soon as I can.</p>
      <a class="button contact-page__button" href={`mailto:${encodedEmail}`}>
        Email
        <Icon name="arrow-right" class="button__icon" />
      </a>
    </section>
  </div>

  <ContactForm encodedEmail={encodedEmail} />

  <dl class="contact-page__facts">
    <div>
      <dt>Area covered</dt>
      <dd>{site.areaCovered}</dd>
    </div>
    {site.hours && (
      <div>
        <dt>Visits</dt>
        <dd>{site.hours}</dd>
      </div>
    )}
  </dl>
</BaseLayout>
