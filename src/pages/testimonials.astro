---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RichText from '../components/RichText/RichText.astro';
import Testimonials from '../components/Testimonials/Testimonials.astro';

const entry = (await getEntry('pages', 'testimonials'))!;
const { Content } = await render(entry);
const page = entry.data;

// Newest first
const items = await Promise.all(
  (await getCollection('testimonials'))
    .sort((a, b) => b.data.number - a.data.number)
    .map(async (testimonial) => ({
      id: `test_${testimonial.data.number}`,
      name: testimonial.data.name,
      image: testimonial.data.image,
      Content: (await render(testimonial)).Content,
    })),
);
---

<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  <RichText>
    <Content />
  </RichText>

  <Testimonials items={items} />
</BaseLayout>
