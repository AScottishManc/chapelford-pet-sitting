---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = (await getEntry('pages', 'testimonials'))!.data;
const testimonials = await Promise.all(
  (await getCollection('testimonials'))
    .sort((a, b) => b.data.number - a.data.number)
    .map(async (entry) => ({ ...entry.data, Content: (await render(entry)).Content })),
);
---

<BaseLayout title={page.title} description={page.description} sidebar={page.sidebar}>
  <h1>{page.heading ?? page.title}</h1>

  {testimonials.map(({ number, name, caption, image, imageAlt, Content }) => (
    <>
      <article class="testimonial" id={`test_${number}`}>
        <h1>{name}</h1>
        {/* Photos alternate sides by number, as on the old site */}
        <figure class={number % 2 === 1 ? 'odd' : 'even'}>
          <Image src={image} alt={imageAlt ?? name} width={150} height={150} />
          <figcaption>{caption ?? name}</figcaption>
        </figure>
        <Content />
      </article>
      <article class="testimonial">
        <a class="top_link" href="#top"><p>Back to the top</p></a>
      </article>
    </>
  ))}
</BaseLayout>
