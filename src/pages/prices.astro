---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceList, { type PriceGroup } from '../components/PriceList/PriceList.astro';
import RichText from '../components/RichText/RichText.astro';
import { inlineMarkdown } from '../lib/markdown';
import { pawFor } from '../lib/paws';

const entry = (await getEntry('pages', 'prices'))!;
const { Content } = await render(entry);
const page = entry.data;

// Each section matches a service page: names come from that page and prices
// from prices.yaml, so neither is stored twice.
const groups: PriceGroup[] = await Promise.all(
  (await getCollection('priceTable'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (section) => {
      const servicePage = await getEntry('services', section.id);
      if (!servicePage) throw new Error(`price-table.yaml: no service page "${section.id}"`);

      const rows = await Promise.all(
        section.data.rows.map(async (row) => {
          const service = servicePage.data.services.find((s) => s.id === row.service);
          if (!service) throw new Error(`price-table.yaml: no service "${row.service}" on the ${section.id} page`);
          const price = (await getEntry(service.price))!.data;
          return {
            name: service.name,
            time: row.time,
            marker: row.marker,
            price: price.amount,
            unit: price.unit,
            href: `/${section.id}/#${service.id}`,
          };
        }),
      );

      return { heading: section.data.heading, icon: pawFor(section.id), rows, notes: section.data.notes };
    }),
);
---

<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  <RichText>
    <Content />
  </RichText>

  <PriceList groups={groups} />

  {page.outro.map((paragraph) => <p set:html={inlineMarkdown(paragraph)} />)}
</BaseLayout>
