---
// A page for each news article: /news/new-insurance/
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon/Icon.astro';
import RichText from '../../components/RichText/RichText.astro';
import { formatDate, getNewsPosts, type NewsPost } from '../../lib/news';

export async function getStaticPaths() {
  const posts = await getNewsPosts();
  // Posts are newest first, so "newer" is the one before
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

interface Props {
  post: NewsPost;
  newer?: NewsPost;
  older?: NewsPost;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, image, imageAlt, imagePosition } = post.data;
---

<BaseLayout
  title={`${title} | News`}
  description={post.excerpt}
  heading={title}
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'News', href: '/news/' }, { label: title }]}
>
  <p class="article__date">
    Published <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
  </p>

  <RichText>
    {image && (
      <p>
        <Image
          class={`rich-text__image rich-text__image--${imagePosition}`}
          src={image}
          alt={imageAlt ?? ''}
          width={imagePosition === 'centre' ? 960 : 600}
        />
      </p>
    )}
    <Content />
  </RichText>

  <nav class="article__nav" aria-label="More news">
    {older ? (
      <a class="article__nav-link article__nav-link--older" href={`/news/${older.slug}/`}>
        <Icon name="arrow-right" class="article__nav-icon" />
        <span class="article__nav-label">Previous article</span>
        <span class="article__nav-title">{older.data.title}</span>
      </a>
    ) : null}
    {newer && (
      <a class="article__nav-link article__nav-link--newer" href={`/news/${newer.slug}/`}>
        <span class="article__nav-label">Next article</span>
        <span class="article__nav-title">{newer.data.title}</span>
        <Icon name="arrow-right" class="article__nav-icon" />
      </a>
    )}
  </nav>
</BaseLayout>
