---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsList from '../../components/NewsList/NewsList.astro';
import RichText from '../../components/RichText/RichText.astro';
import { getNewsPosts } from '../../lib/news';

const entry = (await getEntry('pages', 'news'))!;
const { Content } = await render(entry);
const page = entry.data;
const posts = await getNewsPosts();

// Old links pointed at #blog_15 on this page; send them to the article
const redirects = Object.fromEntries(posts.map((post) => [`#blog_${post.data.number}`, `/news/${post.slug}/`]));
---

<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  <RichText>
    <Content />
  </RichText>

  <NewsList posts={posts} />

  <script is:inline define:vars={{ redirects }}>
    if (redirects[window.location.hash]) window.location.replace(redirects[window.location.hash]);
  </script>
</BaseLayout>
