---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock/CtaBlock.astro';
import IconList from '../components/IconList/IconList.astro';
import RichText from '../components/RichText/RichText.astro';

const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const { title, heading, description, iconList, ctaBlock } = home.data;
---

<BaseLayout title={title} description={description} sidebar={[]}>
  <h1>{heading ?? title}</h1>
  <RichText>
    <Content />
  </RichText>
  {iconList && <IconList {...iconList} />}
  {ctaBlock && <CtaBlock {...ctaBlock} />}
</BaseLayout>
