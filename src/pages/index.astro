---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

const home = (await getEntry('pages', 'home'))!;
const { Content } = await render(home);
const { title, heading, description, image, imageAlt } = home.data;
---

<BaseLayout title={title} description={description} sidebar={['recent-news']}>
  <h1>{heading ?? title}</h1>
  {image && <Image class="img_right" src={image} alt={imageAlt ?? ''} />}
  <Content />
</BaseLayout>
