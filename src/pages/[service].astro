---
// Service pages: /cats/, /dogs/, /other-pets/
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro/Intro.astro';
import RichText from '../components/RichText/RichText.astro';
import ServiceCard from '../components/ServiceCard/ServiceCard.astro';
import { inlineMarkdown } from '../lib/markdown';
import { pawFor } from '../lib/paws';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { service: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const page = entry.data;

const icon = pawFor(entry.id);

const services = await Promise.all(
  page.services.map(async (service) => {
    const price = (await getEntry(service.price))!.data;
    return { ...service, price: price.amount, priceUnit: price.unit };
  }),
);
---

<BaseLayout title={`${page.title} | Services`} description={page.description} heading={page.title} heroImage={page.heroImage}>
  {page.intro && <Intro text={page.intro} />}

  <RichText>
    <Content />
  </RichText>

  <section class="service-page__services">
    <h2>Services available</h2>
    <div class="service-page__cards">
      {services.map((service) => <ServiceCard {...service} icon={icon} />)}
    </div>
  </section>

  <div class="service-page__outro">
    {page.outro.map((paragraph) => <p set:html={inlineMarkdown(paragraph)} />)}
  </div>
</BaseLayout>
