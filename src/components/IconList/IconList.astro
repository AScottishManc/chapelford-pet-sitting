---
import Icon, { type IconName } from '../Icon/Icon.astro';
import { inlineMarkdown } from '../../lib/markdown';
import './_icon-list.scss';

interface Props {
  title?: string;
  items: string[];
  icon?: IconName;
  columns?: 1 | 2;
  class?: string;
}

const { title, items, icon = 'paw-cat', columns = 2, class: className } = Astro.props;
---

<section class:list={['icon-list', { 'icon-list--single': columns === 1 }, className]}>
  {title && <h2 class="icon-list__title">{title}</h2>}
  <ul class="icon-list__list">
    {items.map((item) => (
      <li class="icon-list__item">
        <Icon name={icon} class="icon-list__icon" />
        <span set:html={inlineMarkdown(item)} />
      </li>
    ))}
  </ul>
</section>
