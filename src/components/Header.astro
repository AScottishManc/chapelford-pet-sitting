---
import { getEntry } from 'astro:content';
import Icon from './Icon/Icon.astro';
import logoSmall from '../assets/images/brand/logo_sml.png';
import logoMedium from '../assets/images/brand/logo_med.png';
import logoLarge from '../assets/images/brand/logo_lge.png';

const site = (await getEntry('settings', 'site'))!.data;
---

<header class="site-logo">
  <a href="/" title="Back to the the main page" id="logo">
    <picture>
      <source media="(min-width: 500px)" srcset={encodeURI(logoLarge.src)} />
      <source media="(min-width: 400px)" srcset={encodeURI(logoMedium.src)} />
      <img
        src={logoSmall.src}
        width={logoSmall.width}
        height={logoSmall.height}
        alt={site.businessName}
      />
    </picture>
  </a>
</header>

<div id="header-aside">
  <!-- Space where the old Google search box sat (the service was retired) -->
  <div id="search" aria-hidden="true"></div>

  <div id="telephone">
    <p><span class="bold">Telephone:</span> {site.phone}</p>
  </div>

  <ul id="icons">
    {site.facebook && (
      <li>
        <a href={site.facebook} title={`${site.businessName}'s Facebook page`}>
          <Icon name="facebook" label="Facebook" />
        </a>
      </li>
    )}
    <li>
      <a href="/contact/" title="Contact details to get in touch">
        <Icon name="email" label="Email" />
      </a>
    </li>
  </ul>
</div>
