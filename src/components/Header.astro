---
// Logo plus the telephone number and Facebook/email icons, as on the old site.
// The old Google site search box is not recreated (the service was retired).
import { getEntry } from 'astro:content';
import logoSmall from '../assets/images/brand/logo_sml.png';
import logoMedium from '../assets/images/brand/logo_med.png';
import logoLarge from '../assets/images/brand/logo_lge.png';
import facebook32 from '../assets/images/ui/facebook_32.gif';
import facebook48 from '../assets/images/ui/facebook_48.gif';
import email32 from '../assets/images/ui/email_32.gif';
import email48 from '../assets/images/ui/email_48.gif';

const site = (await getEntry('settings', 'site'))!.data;
---

<header class="site-logo">
  <a href="/" title="Back to the the main page" id="logo">
    <picture>
      <source media="(min-width: 500px)" srcset={encodeURI(logoLarge.src)} />
      <source media="(min-width: 400px)" srcset={encodeURI(logoMedium.src)} />
      <img
        src={logoSmall.src}
        width={logoSmall.width}
        height={logoSmall.height}
        alt={site.businessName}
      />
    </picture>
  </a>
</header>

<div id="header-aside">
  <!-- Space where the old Google search box sat (the service was retired) -->
  <div id="search" aria-hidden="true"></div>

  <div id="telephone">
    <p><span class="bold">Telephone:</span> {site.phone}</p>
  </div>

  <ul id="icons">
    {site.facebook && (
      <li>
        <a href={site.facebook} title={`${site.businessName}'s Facebook page`}>
          <picture>
            <source media="(min-width: 860px)" srcset={encodeURI(facebook48.src)} />
            <img src={facebook32.src} alt="Facebook icon" />
          </picture>
        </a>
      </li>
    )}
    <li>
      <a href="/contact/" title="Contact details to get in touch">
        <picture>
          <source media="(min-width: 860px)" srcset={encodeURI(email48.src)} />
          <img src={email32.src} alt="Email icon" />
        </picture>
      </a>
    </li>
  </ul>
</div>
