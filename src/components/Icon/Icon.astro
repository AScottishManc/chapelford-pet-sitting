---
import './_icon.scss';

const icons = import.meta.glob<string>('../../icons/*.svg', { query: '?raw', import: 'default', eager: true });

export type IconName =
  | 'arrow-right'
  | 'arrow-up'
  | 'chevron-down'
  | 'close'
  | 'download'
  | 'email'
  | 'facebook'
  | 'menu'
  | 'paw-cat'
  | 'paw-dog'
  | 'paw-rabbit'
  | 'phone';

interface Props {
  name: IconName;
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
const svg = icons[`../../icons/${name}.svg`];
if (!svg) throw new Error(`No icon "${name}" in src/icons`);

const classes = ['icon', className].filter(Boolean).join(' ');
const accessibility = label ? `role="img" aria-label="${label.replace(/"/g, '&quot;')}"` : 'aria-hidden="true"';
const html = svg.replace('<svg ', `<svg class="${classes}" focusable="false" ${accessibility} `);
---
<Fragment set:html={html} />
