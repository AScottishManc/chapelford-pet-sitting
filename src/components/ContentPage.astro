---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from './Intro/Intro.astro';
import RichText from './RichText/RichText.astro';

interface Props {
  id: string;
  sectionId?: string;
}

const { id, sectionId } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) throw new Error(`No page content "src/content/pages/${id}.md"`);
const { Content } = await render(entry);
const page = entry.data;
---
<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  {page.intro && <Intro text={page.intro} />}
  <section id={sectionId}>
    <RichText>
      <Content />
    </RichText>
  </section>
</BaseLayout>
