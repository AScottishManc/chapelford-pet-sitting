---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  id: string;
  sectionId?: string;
}

const { id, sectionId } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) throw new Error(`No page content "src/content/pages/${id}.md"`);
const { Content } = await render(entry);
const page = entry.data;
---
<BaseLayout title={page.title} description={page.description} heading={page.heading ?? page.title}>
  {
    sectionId ? (
      <section id={sectionId}>
        {page.image && <Image class="img_right" src={page.image} alt={page.imageAlt ?? ''} />}
        <Content />
      </section>
    ) : (
      <>
        {page.image && <Image class="img_right" src={page.image} alt={page.imageAlt ?? ''} />}
        <Content />
      </>
    )
  }
</BaseLayout>
