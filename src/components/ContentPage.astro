---
// A page whose content is a single Markdown file in src/content/pages:
// heading, optional framed photo, then the Markdown body.
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  /** File name in src/content/pages, without .md */
  id: string;
  /** Optional id for a section wrapping the page, for page-specific styles */
  sectionId?: string;
}

const { id, sectionId } = Astro.props;
const entry = await getEntry('pages', id);
if (!entry) throw new Error(`No page content "src/content/pages/${id}.md"`);
const { Content } = await render(entry);
const page = entry.data;
---

<BaseLayout title={page.title} description={page.description} sidebar={page.sidebar}>
  {
    sectionId ? (
      <section id={sectionId}>
        <h1>{page.heading ?? page.title}</h1>
        {page.image && <Image class="img_right" src={page.image} alt={page.imageAlt ?? ''} />}
        <Content />
      </section>
    ) : (
      <>
        <h1>{page.heading ?? page.title}</h1>
        {page.image && <Image class="img_right" src={page.image} alt={page.imageAlt ?? ''} />}
        <Content />
      </>
    )
  }
</BaseLayout>
