---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from '../Icon/Icon.astro';
import { blockMarkdown } from '../../lib/markdown';
import './_link-card.scss';

interface Props {
  name: string;
  url: string;
  logo: ImageMetadata;
  description: string;
  secondary?: { label: string; url: string };
}

const { name, url, logo, description, secondary } = Astro.props;
---

<article class="link-card">
  <Image class="link-card__logo" src={logo} alt={`${name} logo`} width={Math.min(logo.width, 400)} />
  <div class="link-card__body">
    <h2 class="link-card__title">{name}</h2>
    <div class="link-card__description" set:html={blockMarkdown(description)} />
    <div class="link-card__actions">
      <a class="button" href={url}>
        Visit {name}
        <Icon name="arrow-right" class="button__icon" />
      </a>
      {secondary && (
        <a class="button button--secondary" href={secondary.url}>{secondary.label}</a>
      )}
    </div>
  </div>
</article>
